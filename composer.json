{
    "name": "deaduseful/laravel-domain-api",
    "description": "DeadUseful Laravel Domain",
    "keywords": ["laravel", "domain", "api"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "deaduseful/opensrs-lookup": "dev-master",
        "deaduseful/whois-lookup": "dev-master",
        "laravel/framework": "^8.0|^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.12",
        "fakerphp/faker": "^1.21",
        "laravel/laravel": "^8.0|^9.0|^10.0|^11.0",
        "mockery/mockery": "^1.4.4",
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Deaduseful\\DomainApi\\": "src",
            "Deaduseful\\DomainApi\\Tests\\": "tests"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "7.4"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
