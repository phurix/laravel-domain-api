{
    "name": "deaduseful/laravel-domain-api",
    "description": "DeadUseful Laravel Domain",
    "keywords": ["laravel", "domain", "api"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "deaduseful/opensrs-lookup": "dev-master",
        "deaduseful/whois-lookup": "dev-master",
        "laravel/framework": "^8.0|^9.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.6",
        "fzaninotto/faker": "^1.4",
        "laravel/laravel": "^8.6",
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Deaduseful\\DomainApi\\": "src",
            "Deaduseful\\DomainApi\\Tests\\": "tests"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
