{
    "name": "deaduseful/laravel-domain-api",
    "description": "DeadUseful Laravel Domain",
    "keywords": ["laravel", "domain", "api"],
    "license": "MIT",
    "type": "library",
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:deaduseful/whois-lookup.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:deaduseful/opensrs-lookup.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "deaduseful/opensrs-lookup": "dev-master",
        "deaduseful/whois-lookup": "dev-master",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "spatie/laravel-rdap": "^1.4"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.23",
        "laravel/laravel": "^10.0|^11.0|^12.0",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Deaduseful\\DomainApi\\": "src",
            "Deaduseful\\DomainApi\\Tests\\": "tests"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
